# Database
POSTGRES_USER=nexus
POSTGRES_PASSWORD=changeme
POSTGRES_DB=nexusdb

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters
JWT_SECRET=changeme

# TMDB — get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Transcoder — shared secret between api and transcoder service(s)
TRANSCODER_SECRET=changeme

# Path on the Docker host that contains your media files
MEDIA_PATH=/mnt/media

# Nginx ports
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Set to true ONLY when something in front of Nexus terminates TLS.
# It enables HSTS, tells browsers to upgrade asset requests to https, and marks
# the auth cookies Secure.
# Leave it false for a normal LAN install reached over plain http://<server-ip>.
# Turning it on there breaks two things: the browser rewrites asset URLs to
# https (which the server can't answer, so the UI renders blank) and it drops
# the Secure auth cookies, so every login immediately logs itself back out.
NEXUS_HTTPS=false

# Logging level: fatal | error | warn | info | debug | trace (default: info)
LOG_LEVEL=info

# Absolute path to the plugins directory (default: /plugins)
PLUGINS_PATH=/plugins
