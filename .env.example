# Database
POSTGRES_USER=nexus
POSTGRES_PASSWORD=changeme
POSTGRES_DB=nexusdb

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changeme

# TMDB — get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Transcoder — shared secret between api and transcoder service(s).
# Must be >= 32 characters — the server refuses to start otherwise.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
TRANSCODER_SECRET=changeme

# Path on the Docker host that contains your media files
MEDIA_PATH=/mnt/media

# Nginx ports
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Set to true ONLY when something in front of Nexus terminates TLS.
# It enables HSTS and tells browsers to upgrade asset requests to https.
# Leave it unset for a normal LAN install reached over plain HTTP — turning it
# on there makes the browser rewrite asset URLs to https, which the server
# can't answer, and the web UI renders blank.
NEXUS_HTTPS=false
